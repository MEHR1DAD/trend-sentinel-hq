    },
    {
      "id": "vip_multi_agent_withyashar_26616",
      "pipeline": "vip_multi_agent",
      "node": "withyashar",
      "msg_id": 26616,
      "text": "ترامپ درباره ایران:\nایرانی‌ها سلاح‌های فوق‌العاده‌ای می‌سازند. آن‌ها آدم‌های بسیار باهوشی هستند، اما ما حسابی دهنشونو سرویس می‌کنیم.\n@WarRoom",
