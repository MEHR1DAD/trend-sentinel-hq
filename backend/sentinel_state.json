    },
    {
      "id": "vip_multi_agent_Ali_bk_8_6959",
      "pipeline": "vip_multi_agent",
      "node": "Ali_bk_8",
      "msg_id": 6959,
      "text": "به نظر می‌رسد یک کشتی هدف قرار گرفته است\n\nوقوع آتش‌سوزی در آب‌های دریای عمان در نزدیکی شهر صحار رصد شده است\n\nA vessel appears to have been targeted\n\nA fire has been detected in the waters of the Gulf of Oman near the city of Sohar",
