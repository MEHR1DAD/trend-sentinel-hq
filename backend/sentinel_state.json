      "pipeline": "vip_multi_agent",
      "node": "Alibk3",
      "msg_id": 39087,
      "text": "القيادة المركزية الأميركية تعلن استهداف مركباً شراعياً تابعاً لإيران",
      "is_edit": false,
      "enqueued_at": 1792010317.7063496,
