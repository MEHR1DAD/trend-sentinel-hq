    {
      "id": "vip_multi_agent_withyashar_25704",
      "pipeline": "vip_multi_agent",
      "node": "withyashar",
      "msg_id": 25704,
      "text": "ترامپ درباره ایران:\nتمام مسئله مربوط به سلاح هسته‌ای بود، و ما با استفاده از بمب‌افکن‌های «بی-۲» از قبل به آن رسیدگی کرده‌ایم. آن‌ها هرگز به سلاح هسته‌ای دست نخواهند یافت.\n@WarRoom",
      "is_edit": false,
      "enqueued_at": 1792084264.3173287,
