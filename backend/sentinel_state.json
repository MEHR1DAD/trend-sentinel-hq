    {
      "id": "vip_multi_agent_VahidOnline_78732",
      "pipeline": "vip_multi_agent",
      "node": "VahidOnline",
      "msg_id": 78732,
      "text": "حکم اعدام «احمد پرویز»، وکیل پیشین دادگستری که به اتهام قتل همسرش «منصوره قدیری‌جاوید»، خبرنگار و پژوهشگر خبرگزاری ایرنا، به قصاص محکوم شده بود، اجرا شد. او آبان۱۴۰۳ همسرش را در خانه‌شان در شمال تهران با ضربات دمبل و چاقو کشته بود.\n@VahidHeadline\n\n📡 @VahidOnline",
      "is_edit": false,
